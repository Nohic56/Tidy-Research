{
  "name": "tidy-research",
  "version": "1.0.0",
  "private": true,
  "description": "Firefox research shortcuts and local tracking-parameter cleanup",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "lint": "web-ext lint --source-dir extension --warnings-as-errors",
